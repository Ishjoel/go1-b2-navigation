Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/LaserScan
      Topic: /scan
      Name: LaserScan
      Enabled: true
      Size (m): 0.03
      Style: Points
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Marker Scale: 0.5
    - Class: rviz_default_plugins/Odometry
      Topic: /odom
      Name: Odometry
      Enabled: true
      Keep: 200
      Covariance:
        Position: false
  Tools: []
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6
      Focal Point: {X: 0, Y: 0, Z: 0.3}
      Pitch: 0.4
      Yaw: 0
Window Geometry:
  Height: 800
  Width: 1200
