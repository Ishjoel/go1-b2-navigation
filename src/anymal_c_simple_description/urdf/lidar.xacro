<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
 <link name="navigation_lidar"/>
 <joint name="navigation_lidar_mount" type="fixed"><parent link="base"/><child link="navigation_lidar"/><origin xyz="0 0 0.35" rpy="0 0 0"/></joint>
 <gazebo reference="navigation_lidar"><sensor name="navigation_lidar" type="gpu_lidar">
 <always_on>true</always_on><update_rate>15</update_rate><topic>/scan</topic>
 <gz_frame_id>navigation_lidar</gz_frame_id><lidar><scan><horizontal><samples>720</samples><min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle></horizontal></scan><range><min>0.12</min><max>20</max><resolution>0.01</resolution></range></lidar>
 </sensor></gazebo>
</robot>